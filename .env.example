# Copie para .env e preencha:  cp .env.example .env
# Tudo aqui entra NO BUILD. Mudou algo? docker compose up -d --build

# Endereço do site, sem barra no fim. É a ÚNICA fonte do domínio
# (canonical, sitemap, robots, JSON-LD, imagem de compartilhamento).
# Versão de teste:
SITE_URL=https://ls.vhmedeiros.dev.br
# Domínio definitivo do cliente (quando aprovado):
# SITE_URL=https://www.dominiodocliente.com.br

# true  = versão de teste: selos amarelos "Falta confirmar", faixa no topo
#         e lista de pendências no fim da página
# false = versão final, sem nada disso
SHOW_PENDING=true

# false = Google NÃO indexa (meta noindex + X-Robots-Tag + robots.txt bloqueando)
# true  = liberado para aparecer no Google
# ATENÇÃO: ALLOW_INDEXING=true com SHOW_PENDING=true faz o build FALHAR de propósito.
ALLOW_INDEXING=false

# Porta local (só 127.0.0.1) para testar na própria VM: curl -I http://127.0.0.1:3010
HOST_PORT=3010

# --- Caddy em container (VM atual: container "lupa-caddy") ---
# Descomente NA VM. Liga o site à rede do Caddy (veja docker-compose.caddy.yml).
# Confirme o nome da rede com:
#   docker inspect lupa-caddy --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
# PROXY_NETWORK=nome-da-rede-do-caddy

# Código do Google Search Console (só se escolher o método "tag HTML")
GOOGLE_SITE_VERIFICATION=

# --- Rastreamento: deixe VAZIO na versão de teste ---
# Recomendado: usar só o GTM e configurar o resto dentro dele.
NEXT_PUBLIC_GTM_ID=
# Ou direto, sem GTM:
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_WA_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
